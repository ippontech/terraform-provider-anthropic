test {
  parallel = true
}

# Firing a routine starts a real Claude Code session billed to a claude.ai
# subscription and needs a token generated by hand in the web UI, so this test
# only plans the public example; the action is invoked only at apply time. The
# fire request itself is covered by the Go tests against an httptest server.
# The action uses none of the provider's credentials, but the provider needs
# one to configure.
provider "anthropic" {
  api_key = "dummy-api-key"
}

run "claude_code_routine_fire_plan" {
  command = plan

  module {
    source = "../examples/actions/claude_code_routine_fire"
  }

  variables {
    routine_id    = "trig_01ABCDEFGHJKLMNOPQRSTUVW"
    routine_token = "sk-ant-oat01-dummy-token"
    release       = "2.0.0"
  }

  assert {
    condition     = terraform_data.release.input == "2.0.0"
    error_message = "Expected the release trigger to carry the planned version."
  }
}
