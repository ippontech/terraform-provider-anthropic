{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-reminders.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(touch /tmp/claude-pr-desc-done-*)",
      "Bash(touch /tmp/claude-knowledge-done-*)"
    ]
  },
  "enabledPlugins": {
    "terraform@claude-plugins-official": true
  }
}
